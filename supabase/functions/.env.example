# Variables de la Edge Function `contact` en local: copia este archivo a supabase/functions/.env
# (no se versiona) y arranca con `npx supabase functions serve --env-file supabase/functions/.env`.
# Las claves de Turnstile de abajo son las de prueba públicas de Cloudflare: siempre aprueban.
# En producción se configuran con `npx supabase secrets set` (ver docs/supabase.md).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4173
ALLOWED_HOSTNAMES=example.com
