# Copia este archivo como .env y completa los valores.

# URL del proyecto Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave pública anon/publishable (nunca la service_role)
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL pública del sitio, sin barra final (canonical, Open Graph, sitemap y robots.txt)
VITE_SITE_URL=https://asesoriamicroempresarialsas.pages.dev
